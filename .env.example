# Copy to ".env" and fill in your key. Never commit .env. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# ---- Models (generation and embeddings are separate) ----
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Changing EMBEDDING_MODEL/DIMENSIONS after indexing? Use a new CHROMA_COLLECTION (or delete the data) and re-index.

# ---- Chunking (characters; ~4 characters = 1 token) ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=80

# ---- Retrieval ----
CANDIDATE_K=15              # chunks fetched from the vector DB before re-ranking
TOP_K=4                     # chunks finally sent to the LLM
SIMILARITY_THRESHOLD=0.5    # minimum cosine similarity for a chunk to be used (tune with the scores shown in the UI)
RERANK_ALPHA=0.7            # final = alpha*vector + (1-alpha)*BM25

# ---- Generation / reliability ----
RAG_TEMPERATURE=0.1
LLM_MAX_RETRIES=2           # retries for 429 / 5xx / timeout / network errors
RETRY_BACKOFF_SECONDS=1.0   # doubles each retry

# ---- Uploads ----
MAX_UPLOAD_MB=10
MAX_FILES_PER_UPLOAD=5

# ---- Storage (local run: defaults to backend/data; Docker sets DATA_DIR=/data) ----
# DATA_DIR=./data
# CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=studymate_chunks
DEFAULT_USER_ID=default

# ---- Web ----
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Frontend build only: leave empty to use same-origin /api (Vite proxy in dev, nginx in Docker)
# VITE_API_URL=
# Test/dev only: point Gemini calls at a local stub
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
